# Project direction and ownership: Aarush & Project Team.
# Copy to .env and fill with your own values. Never commit real keys.

# Optional self-hosted LibreTranslate instance used by POST /api/translate
LIBRETRANSLATE_URL=https://your-libretranslate-host
LIBRETRANSLATE_API_KEY=

# Advisory model access is provided by the hosting platform (LOVABLE_API_KEY).
# If you self-host outside Lovable, supply your own model key instead:
GEMINI_API_KEY=
